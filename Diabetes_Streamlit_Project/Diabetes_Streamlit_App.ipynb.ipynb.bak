     "text": [
      "\n",
      "import streamlit as st\n",
      "import pandas as pd\n",
      "import numpy as np\n",
      "import joblib\n",
      "from sklearn.datasets import load_diabetes\n",
      "\n",
      "\n",
      "# =========================================================\n",
      "# PAGE CONFIGURATION\n",
      "# =========================================================\n",
      "\n",
      "st.set_page_config(\n",
      "    page_title=\"Diabetes Progression Prediction\",\n",
      "    page_icon=\"🩺\",\n",
      "    layout=\"wide\"\n",
      ")\n",
      "\n",
      "\n",
      "# =========================================================\n",
      "# LOAD FINAL MODEL\n",
      "# =========================================================\n",
      "\n",
      "model = joblib.load(\"diabetes_model.pkl\")\n",
      "\n",
      "\n",
      "# =========================================================\n",
      "# LOAD DATASET\n",
      "# =========================================================\n",
      "\n",
      "diabetes = load_diabetes(as_frame=True)\n",
      "df = diabetes.frame\n",
      "\n",
      "\n",
      "# =========================================================\n",
      "# CUSTOM CSS\n",
      "# =========================================================\n",
      "\n",
      "st.markdown(\"\"\"\n",
      "<style>\n",
      "\n",
      ".main-title {\n",
      "    font-size: 42px;\n",
      "    font-weight: 800;\n",
      "}\n",
      "\n",
      ".subtitle {\n",
      "    font-siz\n"
     ]
    }
   ],
   "source": [
    "with open(\"app.py\", \"r\", encoding=\"utf-8\") as f:\n",
    "    app_code = f.read()\n",
    "\n",
    "print(app_code[:1000])"
   ]
