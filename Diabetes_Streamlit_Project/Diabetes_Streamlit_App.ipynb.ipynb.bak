    "            '</div>',\n",
    "            unsafe_allow_html=True\n",
    "        )\n",
    "\n",
    "        st.markdown(\n",
    "            '<div class=\"tagline\">'\n",
    "            '✨ Analyze • Optimize • Predict'\n",
