    "\n",
    "    with col2:\n",
    "\n",
    "        st.metric(\n",
    "            \"🧬 Input Features\",\n",
    "            \"10\"\n",
    "        )\n",
    "\n",
    "    with col3:\n",
    "\n",
    "        st.metric(\n",
    "            \"🏆 Final Model\",\n",
    "            \"Gradient Boosting\"\n",
    "        )\n",
    "\n",
    "\n",
    "    st.write(\"\")\n",
    "\n",
    "    st.markdown(\n",
    "        '<div class=\"section-title\">'\n",
