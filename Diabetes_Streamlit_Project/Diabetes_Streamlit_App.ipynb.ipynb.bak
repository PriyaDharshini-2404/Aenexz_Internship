    "    ]\n",
    ")\n",
    "\n",
    "st.sidebar.divider()\n",
    "\n",
    "st.sidebar.write(\n",
    "    \"🧠 Machine Learning Regression\"\n",
    ")\n",
    "\n",
    "st.sidebar.write(\n",
    "    \"🏆 Final Model: Gradient Boosting\"\n",
    ")\n",
    "\n",
    "\n",
    "# =========================================================\n",
    "# HOME\n",
    "# =========================================================\n",
    "\n",
    "if page == \"🏠 Home\":\n",
    "\n",
    "    col1, col2 = st.columns([1.2, 1])\n",
    "\n",
    "    with col1:\n",
    "\n",
    "        st.markdown(\n",
    "            '<div class=\"main-title\">'\n",
    "            '🩺 Diabetes Progression Prediction'\n",
    "            '</div>',\n",
    "            unsafe_allow_html=True\n",
    "        )\n",
    "\n",
    "        st.markdown(\n",
    "            '<div class=\"subtitle\">'\n",
    "            'Smart Machine Learning Application for '\n",
